{
  "spec_version": "0.1",
  "name": "Thingery",
  "description": "Open item database and MCP server for AI agents to list, find, and trade second-hand goods.",
  "url": "https://thingery.dev",
  "capabilities": [
    {
      "type": "mcp",
      "transport": "http",
      "endpoint": "https://thingery.dev/mcp",
      "protocol": "streamable-http-stateless",
      "method": "POST",
      "auth": {
        "type": "oauth2",
        "flows": {
          "authorization_code": {
            "authorization_endpoint": "https://thingery.dev/oauth/authorize",
            "token_endpoint": "https://thingery.dev/oauth/token",
            "revocation_endpoint": "https://thingery.dev/oauth/revoke",
            "registration_endpoint": "https://thingery.dev/oauth/register",
            "grant_types": ["authorization_code", "refresh_token"],
            "code_challenge_methods": ["S256"],
            "scopes": ["mcp"]
          }
        },
        "discovery": "https://thingery.dev/.well-known/oauth-authorization-server",
        "resource_metadata": "https://thingery.dev/.well-known/oauth-protected-resource",
        "token_format": "thgo_... (30 min) / thgr_... refresh (30 d, rotating)",
        "legacy_bearer_key_format": "thg_...",
        "required_for": ["create_listing", "add_item_image", "my_listings", "update_listing"],
        "notes": "OAuth one-click sign-in recommended for MCP hosts; thg_ API key is the manual/legacy path. Connected applications can be reviewed and revoked at https://thingery.dev/apps. Anonymous public reads always work; invalid credentials get HTTP 401."
      },
      "public_tools": ["describe_category", "search_items", "get_item"],
      "seller_tools": ["create_listing", "add_item_image", "my_listings", "update_listing"]
    }
  ],
  "data_conventions": {
    "price": "integer cents (12500 = EUR 125.00)",
    "condition_scale": ["new", "like_new", "good", "fair", "poor"],
    "shipping_tiers": ["locker", "parcel", "bulky", "local", "unknown"],
    "item_ids": "UUID v4",
    "attributes": "flexible JSONB object of category-specific fields; declared definitions validate types and required keys, unknown keys pass through; discover per category via describe_category"
  },
  "rate_limits": {
    "authenticated_per_minute": 120,
    "anonymous_per_minute": 30
  },
  "docs": {
    "llms_txt": "https://thingery.dev/llms.txt",
    "github": "https://github.com/thingery/thingery"
  }
}
