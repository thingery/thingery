# Copy to .env and adjust. Never commit .env.

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgres://thingery:thingery@localhost:5432/thingery

# REQUIRED for production (docker-compose.prod.yml) — the database container password
POSTGRES_PASSWORD=

# HTTP port for the MCP server + website
PORT=3000

# Public base URL used when building item links in responses
PUBLIC_BASE_URL=http://localhost:3000

# Embeddings (any OpenAI-compatible /v1/embeddings endpoint).
# Leave EMBED_API_KEY empty to run keyword-only search (no embeddings API needed;
# the pgvector extension is still required by the schema — see README "No Docker?").
EMBED_API_URL=https://api.openai.com/v1/embeddings
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Optional: fixed API key for the demo seller created by `npm run db:seed`
DEMO_SELLER_KEY=

# Chat (the /chat page): any OpenAI-compatible /v1/chat/completions endpoint.
# Leave LLM_API_KEY empty to disable chat (MCP and signup still work).
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Session cookie signing. Generate one: openssl rand -hex 32
# If unset, an ephemeral secret is used and logins reset on every restart.
SESSION_SECRET=

# OAuth (MCP one-click sign-in). Set to 1 to disable OAuth entirely —
# OAuth routes return 404 and thgo_ tokens stop authenticating (hosts fall
# back to thg_ API keys). Requires a restart to take effect.
OAUTH_DISABLED=

# OAuth tuning (defaults shown). DCR registrations per IP per hour;
# access/refresh token TTLs in seconds. The token/revoke per-IP backstop is a
# coarse hourly cap on /oauth/token + /oauth/revoke per source IP (the finer
# 60/h per IP+client_id bucket cannot bound client_id rotation alone).
OAUTH_DCR_HOURLY_LIMIT=10
OAUTH_TOKEN_IP_HOURLY_LIMIT=600
OAUTH_ACCESS_TTL_S=1800
OAUTH_REFRESH_TTL_S=2592000

# Order flow — Stripe Connect payouts (spec THI-3 rev 2 §4.4 + rev 3 §11).
# Leave STRIPE_SECRET_KEY empty to disable platform payment entirely (kill
# switch): order tools answer payments_not_configured and listings stay
# buyable as off-platform orders. Test keys (sk_test_…) are always safe.
# STRIPE_WEBHOOK_SECRET is required before payments can be confirmed via
# webhook — with a key set but no webhook secret, the Stripe webhook endpoint
# mounts as a 503 stub and payments stay in pending until configured.
# STRIPE_WEBHOOK_SECRET_PREVIOUS enables zero-downtime secret rotation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Order flow — EasyPost carrier tracking (optional per deployment).
# EASYPOST_API_KEY enables tracker registration; EASYPOST_WEBHOOK_SECRET is
# required for the carrier webhook endpoint (503 stub without it).
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_WEBHOOK_SECRET_PREVIOUS=

# Order flow — admin dispute route (spec §5.3): stays disabled unless the
# key is at least 32 characters.
ADMIN_API_KEY=

# Order flow — windows and abuse caps (defaults shown; positive integers).
# PAYMENT_DEADLINE_HOURS: pending orders cancel when unpaid past this.
# DISPUTE_WINDOW_HOURS: buyer dispute window after delivery.
# SYSTEM_CONFIRMED_DISPUTE_WINDOW_HOURS: window after pickup auto-confirm (14d).
# PICKUP_AUTOCONFIRM_DAYS: sold pickup orders auto-deliver after this.
# IN_TRANSIT_STUCK_DAYS / STALE_SOLD_DAYS: sweep escalations.
# DISPUTE_AUTOREFUND_HOURS: never-shipped disputes auto-refund after this (rev 3 §11.3).
# DISPUTE_STALE_DAYS: unresolved disputes escalate to the operator after this.
# STUCK_MONEY_ALERT_DAYS: payout_pending orders alert the operator after this.
# MAX_PENDING_ORDERS_PER_BUYER / REORDER_COOLDOWN_MINUTES: order-spam caps (F8).
PAYMENT_DEADLINE_HOURS=24
DISPUTE_WINDOW_HOURS=48
SYSTEM_CONFIRMED_DISPUTE_WINDOW_HOURS=336
PICKUP_AUTOCONFIRM_DAYS=14
IN_TRANSIT_STUCK_DAYS=21
STALE_SOLD_DAYS=21
DISPUTE_AUTOREFUND_HOURS=72
DISPUTE_STALE_DAYS=7
STUCK_MONEY_ALERT_DAYS=7
MAX_PENDING_ORDERS_PER_BUYER=3
REORDER_COOLDOWN_MINUTES=60
