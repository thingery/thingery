# Copy to .env and adjust. Never commit .env.

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgres://thingery:thingery@localhost:5432/thingery

# REQUIRED for production (docker-compose.prod.yml) — the database container password
POSTGRES_PASSWORD=

# HTTP port for the MCP server + website
PORT=3000

# Public base URL used when building item links in responses
PUBLIC_BASE_URL=http://localhost:3000

# Embeddings (any OpenAI-compatible /v1/embeddings endpoint).
# Leave EMBED_API_KEY empty to run keyword-only search (no embeddings API needed;
# the pgvector extension is still required by the schema — see README "No Docker?").
EMBED_API_URL=https://api.openai.com/v1/embeddings
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Optional: fixed API key for the demo seller created by `npm run db:seed`
DEMO_SELLER_KEY=

# Chat (the /chat page): any OpenAI-compatible /v1/chat/completions endpoint.
# Leave LLM_API_KEY empty to disable chat (MCP and signup still work).
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Session cookie signing. Generate one: openssl rand -hex 32
# If unset, an ephemeral secret is used and logins reset on every restart.
SESSION_SECRET=

# OAuth (MCP one-click sign-in). Set to 1 to disable OAuth entirely —
# OAuth routes return 404 and thgo_ tokens stop authenticating (hosts fall
# back to thg_ API keys). Requires a restart to take effect.
OAUTH_DISABLED=

# OAuth tuning (defaults shown). DCR registrations per IP per hour;
# access/refresh token TTLs in seconds.
OAUTH_DCR_HOURLY_LIMIT=10
OAUTH_ACCESS_TTL_S=1800
OAUTH_REFRESH_TTL_S=2592000
