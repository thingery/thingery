node_modules/
# no-slash form: git stores a symlink as a 120000-mode file BLOB, which the
# directory-only `node_modules/` pattern never matched — that gap let `git add
# -A` sweep a workspace node_modules symlink into history (69cf21e, #402).
# The no-slash form matches files and symlinks too; keep both lines.
node_modules
dist/
# .env* (not just .env): snapshot copies like .env.bak-webpin-* must never
# enter git history either (THI-1363). .env.example stays tracked.
.env*
!.env.example
*.log
.DS_Store
uploads/
# daily metrics snapshots (docs/metrics.md) are runtime output, not content
metrics/

# secrets — never commit, never paste anywhere
secret/
*.pem
*_private_key*
*.key
*.zip

# demo capture renderer output (regenerate with render-demo-video.py)
scripts/demo-capture.mp4
scripts/.demo-frames/
__pycache__/
