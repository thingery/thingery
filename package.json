{
  "name": "thingery",
  "version": "0.1.2",
  "description": "Thingery is the open item database and MCP server for AI agents to list, find, and trade second-hand goods.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "marketplace",
    "second-hand",
    "secondhand",
    "classifieds",
    "thingery"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "mcpName": "io.github.thingery/thingery",
  "bin": {
    "thingery": "dist/index.js"
  },
  "files": [
    "dist",
    "db",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thingery/thingery"
  },
  "homepage": "https://thingery.dev",
  "bugs": {
    "url": "https://github.com/thingery/thingery/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "backfill:reencode": "tsx scripts/reencode-existing-uploads.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "sharp": "0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
